@startuml c4_container
!include [https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml](https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml)

title Container Diagram for PetroAndes OT/IT Integration

System_Boundary(dmz, "Industrial DMZ (Level 3.5)") {
    Container(mosquitto, "Eclipse Mosquitto", "C / MQTT", "Broker receiving raw telemetry from edge sensors.")
    Container(bridge, "OT/IT Bridge", "Python / Node.js", "Normalizes MQTT payloads to CloudEvents and enforces schema.")
    Container(redpanda, "Redpanda Broker", "C++ / Kafka API", "High-throughput event mesh and schema registry.")
    Container(detector, "Anomaly Detector", "Python / Java", "Consumes events, evaluates rules, and publishes alerts.")
    Container(router, "Enterprise Router", "Apache Camel / NiFi", "Routes alerts to the volumetric system.")
}

System_Ext(scada, "Simulated Field Sensors", "Data Generator")
System_Ext(volumetric, "Volumetric Balance System", "REST API")

Rel(scada, mosquitto, "Publishes telemetry", "MQTT (IEC 62443 Conduit)")
Rel(mosquitto, bridge, "Consumes raw data", "MQTT")
Rel(bridge, redpanda, "Publishes CloudEvents", "Kafka API")
Rel(redpanda, detector, "Consumes telemetry", "Kafka API")
Rel(detector, redpanda, "Publishes alerts", "Kafka API")
Rel(redpanda, router, "Consumes alerts", "Kafka API")
Rel(router, volumetric, "POST /segment-status", "HTTPS")

@enduml
